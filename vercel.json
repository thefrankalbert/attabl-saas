{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/reconcile-payments",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/freeze-expired-trials",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/flutterwave-renewals",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/flutterwave-reconcile",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/trial-idle-emails",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800" }]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
