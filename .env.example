# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional: for scripts/apply-restaurant-groups-repair.ts or pnpm db:migrate (Dashboard > Database > password)
SUPABASE_DB_PASSWORD=
# Or full URL: DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Stripe (Billing SaaS)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx
NEXT_PUBLIC_STRIPE_PRICE_ESSENTIEL=price_monthly_essentiel_xxxxx
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=price_monthly_premium_xxxxx
NEXT_PUBLIC_STRIPE_PRICE_ESSENTIEL_YEARLY=price_yearly_essentiel_xxxxx
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_YEARLY=price_yearly_premium_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Resend (Stock Alert Emails)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=Attabl <notifications@attabl.com>

# Cloudflare Turnstile (signup/login anti-bot - leave empty to disable in dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local dev only: skip honeypot/Turnstile when keys or autofill block signup (never set in production)
ALLOW_DEV_AUTH_BYPASS=true

# App
NEXT_PUBLIC_APP_URL=https://attabl.com
NEXT_PUBLIC_APP_DOMAIN=attabl.com
NEXT_PUBLIC_ROOT_DOMAIN=attabl.com

# Cron (Vercel Cron / external scheduler -> POST /api/cron/reconcile-payments)
CRON_SECRET=

# Superadmin bootstrap script (scripts/create-superadmin.ts - never commit real values)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_RESTAURANT_NAME=La Grande Table
SUPERADMIN_TENANT_SLUG=la-grande-table

# Seed de la demo (scripts/seed-demo.ts) - mot de passe partage des comptes demo.
# Jamais en dur dans le code : le litteral precedent est reste lisible des mois.
DEMO_SEED_PASSWORD=

# Seed QA (scripts/seed-qa.ts) - meme regle que DEMO_SEED_PASSWORD.
QA_SEED_PASSWORD=

# Notifications push (Web Push / VAPID)
#
# Sans ces deux cles, les notifications push ne partent pas et RIEN ne casse:
# aucune commande n'echoue, et le bouton d'activation affiche de lui-meme qu'il
# n'est pas configure.
#
# 1. Generer la paire UNE SEULE FOIS, puis la garder (la regenerer desabonne
#    tous les appareils deja enregistres):
#       pnpm dlx web-push generate-vapid-keys
# 2. Les coller ici (fichier local, jamais commite).
# 3. LES POSER AUSSI SUR VERCEL, sinon rien ne marche en ligne. Dans le
#    tableau de bord du projet: Settings > Environment Variables, pour
#    Production, Preview et Development. Ou en ligne de commande:
#       vercel env add NEXT_PUBLIC_VAPID_PUBLIC_KEY production
#       vercel env add VAPID_PRIVATE_KEY production
# 4. REDEPLOYER. `NEXT_PUBLIC_VAPID_PUBLIC_KEY` est figee dans le code au
#    moment de la compilation: l'ajouter sans redeployer laisse le bouton
#    d'activation invisible, et on croit a tort que la fonctionnalite est
#    cassee.
# 5. Verifier: ouvrir l'admin du restaurant > Reglages > onglet Sons >
#    "Notifications push" > Activer, accepter la demande du navigateur, puis
#    passer une commande de test. La notification doit apparaitre meme
#    application fermee.
#
# Sur iPhone et iPad, les notifications push n'existent QUE si ATTABL a ete
# ajoute a l'ecran d'accueil (bouton Partager). Dans un onglet Safari, le
# bouton d'activation ne s'affiche pas - c'est une limite d'Apple, pas un bug.
#
# La cle publique est publique par construction (le navigateur l'envoie au
# service de push). La privee ne doit jamais sortir du serveur ni d'un commit.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
