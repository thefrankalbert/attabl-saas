# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
tests/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code worktrees
.claude/worktrees/
.worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.example
!.env.staging.example

# vercel
.vercel

# supabase temp
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA generated files
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js
.gstack/

# Local CI / agent output logs (repo root)
/build*.log
/build_*.log
/ci_*.log
/test_*.log

# DB migration backups (local/CI artifacts, never commit). The real .env.staging
# is already covered by the .env* rule above; .env.staging.example is un-ignored.
supabase/backups/

# Local agent tooling / runtime (not part of the app; tracked files already in git
# stay tracked - this only hides newly generated local artifacts)
.claude-flow/
.swarm/
.kiro/
.playwright-cli/
.playwright-mcp/
.mcp.json
claude-flow.config.json
graphify-out/
.agents/
.claude/agents/
.claude/skills/
.claude/commands/
.claude/helpers/
.claude/memory.db

# Local embedded databases (agent/vector stores)
*.rvf
*.rvf.lock
ruvector.db
agentdb.rvf

# Local screenshots / capture artifacts at repo root (QA, design, debugging)
/*.png
/*.jpg
/*.jpeg
command-center-redesign-captures/

# Local design / audit handoff docs (kept locally, not versioned with the app)
/AT-FOOD-DESIGN-BRIEF.md
/AT-FOOD-V1-SPEC.md
/AUDIT-ARCHITECTURE.md
/COMMAND-CENTER-REDESIGN-BRIEF.md
/CONVIVE-REDESIGN-CONTRACT.md
/CONVIVE-REDESIGN-PROMPT.md
/order-confirmed-src.txt

# tokensave (local code-graph tool)
.tokensave/

# Skills CLI (npx skills add) - outil dev local, re-installable
.agents/

# Generated by `serwist build` (see serwist.config.js)
public/sw.js
public/sw.js.map

# Bases locales d'outillage agent (ruflo / agentdb) et configuration de session.
# 4,2 Mo de SQLite, propres a la machine, n'appartenant a aucun chantier du
# produit: ils n'ont rien a faire dans l'historique. Ils etaient non suivis ET
# non ignores, donc a un `git add -A` pres ils partaient dans un commit.
data/
.claude/proven-config.json
.claude/.proven-config-version
