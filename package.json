{
  "name": "attabl-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "seed:demo": "npx tsx scripts/seed-demo.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "bash scripts/run-stock-integration.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:responsive": "playwright test tests/e2e/responsive.spec.ts",
    "test:e2e:ci": "playwright test tests/e2e/home.spec.ts tests/e2e/segments.spec.ts",
    "test:journey": "playwright test --config tests/journeys/playwright.config.ts",
    "test:journey:ui": "playwright test --config tests/journeys/playwright.config.ts --ui",
    "load:k6": "k6 run tests/journeys/load/order-rush.k6.js",
    "db:migrate": "supabase db push",
    "db:migrate:dry": "scripts/db-migrate.sh --target production --dry-run",
    "db:migrate:staging": "scripts/db-migrate.sh --target staging",
    "db:migrate:prod": "scripts/db-migrate.sh --target production --confirm",
    "db:repair-restaurant-groups": "node scripts/apply-restaurant-groups-repair.mjs",
    "db:types": "supabase gen types typescript --linked > src/types/database.generated.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.109.0",
